# PIN สำหรับเข้าแอป (ตัวเลข 4-8 หลัก)
APP_PIN=123456
# ข้อความสุ่มยาว ๆ ใช้เซ็น cookie (สร้างด้วย: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# จาก Google Cloud Console > APIs & Services > Credentials (OAuth client ID แบบ Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3 ค่านี้ได้จากหน้า /setup หลัง deploy ครั้งแรก
GOOGLE_REFRESH_TOKEN=
SHEET_ID=
DRIVE_FOLDER_ID=
