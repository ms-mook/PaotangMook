# PIN สำหรับเข้าแอป (ตัวเลข 4-8 หลัก)
APP_PIN=123456
# ข้อความสุ่มยาว ๆ ใช้เซ็น cookie (สร้างด้วย: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# URL ของเว็บแอป Apps Script (ลงท้ายด้วย /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# ต้องตรงกับค่า SECRET ในไฟล์ apps-script/Code.gs
APPS_SCRIPT_SECRET=change-me-to-another-long-random-string
